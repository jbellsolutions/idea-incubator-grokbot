# Names only. Two places hold keys, never the same file:
#   GrokBot (the orchestrator): .secrets/<system>.env on the bot's computer, by secure secret card or hidden prompt.
#   The worker box (the doer): /opt/incubator/.secrets/worker.env (mode 600, user incubator), typed by Justin on the box.

# --- GrokBot ---
# Slack bot token, chat:write and channels:history on #incubator only
SLACK_BOT_TOKEN=
# Notion integration shared with the Incubator pages only
NOTION_TOKEN=
# GitHub fine-grained token for the bot: the desk repo only, contents read and write
GITHUB_TOKEN=

# --- The worker box (worker.env) ---
# GitHub fine-grained token for the worker: the desk repo, plus create and push private repos under GITHUB_OWNER; no admin, no visibility change
WORKER_GITHUB_TOKEN=
# Slack incoming webhook for the Incubator channel (the worker's watchdog)
SLACK_WEBHOOK_URL=
# Gumroad API token, read sales only (optional)
GUMROAD_ACCESS_TOKEN=
# Orgo workspace API key (hermes-build lane only)
ORGO_API_KEY=
# Claude Code on Justin's Claude subscription: from `claude setup-token`, in the coder user's ~/.profile only
CLAUDE_CODE_OAUTH_TOKEN=
# Hermes' model key, with a monthly cap set in the provider's console (the hermes tier only)
HERMES_MODEL_KEY=
# Codex: no key; `codex login` with Justin's ChatGPT account, as the coder user

# --- Non-secret values Justin gives at intake. Code reads them with os.environ.get; prose writes <NAME>. ---
# The private desk repo (owner/name) between the bot and the worker
DESK_REPO=
# GitHub owner (user or org) the worker creates private repos under
GITHUB_OWNER=
# Gumroad store base URL, e.g. https://<store>.gumroad.com
GUMROAD_STORE_URL=
# Where to download the pack zip (the release page)
PACK_RELEASE_URL=
# Notion parent page the Incubator page sits under
NOTION_PARENT_PAGE=
# Private repo (owner/name) with existing skills to copy from
SKILLS_SOURCE_REPO=
# Private repo (owner/name) with the Hermes team template
HERMES_TEAM_TEMPLATE_REPO=
# Orgo computers and names never to touch, comma-separated (also .secrets/never-touch.txt on both sides). Missing = every Orgo action held
NEVER_TOUCH=
# Never here, never anywhere, on either computer: wallet private keys, seed phrases, exchange keys with trade or withdraw rights.
