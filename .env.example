# Names only. The bot asks for each by a secure secret card or hidden prompt and stores it in .secrets/<system>.env (mode 600).
# Slack bot token, chat:write and channels:history on #incubator only
SLACK_BOT_TOKEN=
# Notion integration shared with the Incubator pages only
NOTION_TOKEN=
# GitHub fine-grained token: create and push private repos under GITHUB_OWNER; no admin, no visibility change
GITHUB_TOKEN=
# Gumroad API token, read sales only (optional; the browser works without it)
GUMROAD_ACCESS_TOKEN=
# Orgo workspace API key (orgo.ai, Justin's workspace)
ORGO_API_KEY=

# Non-secret values Justin pastes at intake (NEEDS-JUSTIN item 13). Code reads them with os.environ.get; prose writes <NAME>.
# GitHub owner (user or org) the bot creates private repos under
GITHUB_OWNER=
# Gumroad store base URL, e.g. https://<store>.gumroad.com
GUMROAD_STORE_URL=
# Where to download the pack zip (the factory release page)
PACK_RELEASE_URL=
# Notion parent page the Incubator page sits under
NOTION_PARENT_PAGE=
# Private repo (owner/name) with existing skills to copy from
SKILLS_SOURCE_REPO=
# Private repo (owner/name) with the Hermes team template
HERMES_TEAM_TEMPLATE_REPO=
# Orgo computers and names the bot must never touch, comma-separated (also written to .secrets/never-touch.txt). Missing = every Orgo action held
NEVER_TOUCH=
# Never here, never anywhere on this computer: wallet private keys, seed phrases, exchange keys with trade or withdraw rights.
